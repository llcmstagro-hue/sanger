# Скопируйте в .env.local и заполните. .env.local в .gitignore — в репозиторий не попадёт.
# Для локальной разработки всё можно оставить пустым.

# --- Приём заявок (/api/lead) ---
# Заявка принимается и без токенов (в дев-режиме пишется в лог сервера).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRM_WEBHOOK_URL=

# --- Аналитика (Яндекс.Метрика) ---
# Метрика подключается только если задан ID.
NEXT_PUBLIC_YM_ID=

# --- Генерация фото-ассетов (локально, в приложение НЕ попадает) ---
# Вариант A — OpenAI (npm run assets). gpt-image-1 требует верификации организации.
OPENAI_API_KEY=
# Вариант B — Higgsfield (npm run assets:hf). Режим Soul — фотореализм людей.
# Ключ: https://cloud.higgsfield.ai → API keys. Формат "KEY_ID:KEY_SECRET".
HF_CREDENTIALS=
